{
  "name": "hagitask-site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port ${PORT_WEBSITE:-43210}",
    "start": "astro dev --host 0.0.0.0",
    "build": "export NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=8192\"; astro build",
    "preview": "astro preview --port ${PORT_WEBSITE:-43210}",
    "astro": "astro",
    "sync": "astro sync",
    "typecheck": "export NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=8192\"; astro check",
    "stage:schemas": "node scripts/schema-payload.mjs",
    "verify": "node scripts/verify-publication.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "clean": "rm -rf .astro dist public/packages",
    "check:registry": "node scripts/check-registry-neutrality.mjs",
    "test:registry": "node --test scripts/check-registry-neutrality.node-test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@hagicode/hagilight": "0.20.0",
    "@hagicode/hagilight-core": "0.20.0",
    "@hagicode/hagitask": "0.1.2",
    "astro": "^7.3.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.16.1"
  }
}
