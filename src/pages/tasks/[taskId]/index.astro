---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import { getCatalog, type DetailDoc, type TaskPresentation } from '@/lib/community-index';

export const getStaticPaths: GetStaticPaths = () => {
  const { details, presentations } = getCatalog();
  return details.map((detail) => ({
    params: { taskId: detail.taskId },
    props: { detail, presentation: presentations[detail.taskId] },
  }));
};

interface Props {
  detail: DetailDoc;
  presentation: TaskPresentation;
}

const { detail, presentation } = Astro.props as unknown as Props;
const markdown = await createMarkdownProcessor();
const nameEn = detail.name['en-US'] ?? Object.values(detail.name)[0] ?? detail.taskId;
const nameZh = detail.name['zh-CN'] ?? nameEn;
const summaryEn = detail.summary['en-US'] ?? '';
const summaryZh = detail.summary['zh-CN'] ?? summaryEn;
const compat = detail.compatibility;
const externalDocs = detail.documentation?.external ?? [];
const hasRequirements = detail.requirements.length > 0;
const packageSourceUrl = `${detail.source}/tree/main/data/${detail.taskId}`;
const contributionGuideUrl = `${detail.source}#contribute-a-task`;
const schemaReferenceUrl = 'https://github.com/HagiCode-org/hagitask/tree/main/schemas';
const storePageContent = Object.fromEntries(
  await Promise.all(
    Object.entries(presentation.storePages).map(async ([locale, source]) => {
      const result = await markdown.render(source);
      return [locale, result.code] as const;
    }),
  ),
);
---

<BaseLayout title={`${nameEn} · HagiTask`}>
  <main class="page">
    <nav class="breadcrumb">
      <a href="/">&larr; <span class="locale-en">All tasks</span><span class="locale-zh">全部任务</span></a>
    </nav>

    <header class="detail__head">
      <div>
        <h1 class="detail__title">
          <span class="locale-en">{nameEn}</span><span class="locale-zh">{nameZh}</span>
        </h1>
        <p class="detail__summary">
          <span class="locale-en block">{summaryEn}</span><span class="locale-zh block">{summaryZh}</span>
        </p>
      </div>
      <div class="detail__actions">
        <a class="btn btn--primary" href={detail.installation.packageUrl}>
          <span class="locale-en">Download package</span><span class="locale-zh">下载包</span>
        </a>
      </div>
    </header>

    <section class="panel store-page" aria-labelledby="store-page-heading">
      <h2 id="store-page-heading"><span class="locale-en">About this task</span><span class="locale-zh">任务介绍</span></h2>
      {
        presentation.storePageLocales.length > 0 ? (
          presentation.storePageLocales.map((locale) => (
          <div class={`store-page__content locale-content locale-content--${locale} ${
            locale === presentation.storePageDefaultLocale && !presentation.storePageLocales.includes('en-US') ? 'locale-content--fallback-en' : ''
          } ${
            locale === presentation.storePageDefaultLocale && !presentation.storePageLocales.includes('zh-CN') ? 'locale-content--fallback-zh' : ''
          }`} set:html={storePageContent[locale]} />
          ))
        ) : (
          <p class="muted">
            <span class="locale-en">No store-page content is available for this task.</span>
            <span class="locale-zh">此任务没有可用的 store-page 内容。</span>
          </p>
        )
      }
    </section>

    <section class="command-catalog" aria-labelledby="commands-heading">
      <div class="command-catalog__intro">
        <h2 id="commands-heading"><span class="locale-en">Commands</span><span class="locale-zh">命令</span></h2>
        {
          presentation.commands.length > 0 ? (
            <nav class="command-nav" aria-label="Command navigation">
              {presentation.commands.map((command) => (
                <a href={`#${command.anchor}`} class="command-nav__link">
                  <code>/{command.label}</code><span>{command.group}</span>
                </a>
              ))}
            </nav>
          ) : (
            <p class="muted">
              <span class="locale-en">This task does not declare a command catalog.</span>
              <span class="locale-zh">此任务未声明命令目录。</span>
            </p>
          )
        }
      </div>
      {
        presentation.commands.length > 0 && (
          <div class="command-list">
            {presentation.commands.map((command) => (
              <article id={command.anchor} class="panel command" tabindex="-1">
                <h3><code>/{command.label}</code></h3>
                <dl class="kv">
                  <div><dt>Group / 分组</dt><dd><span class="locale-en">{command.group['en-US'] ?? Object.values(command.group)[0]}</span><span class="locale-zh">{command.group['zh-CN'] ?? Object.values(command.group)[0]}</span></dd></div>
                  <div><dt>Description / 说明</dt><dd><span class="locale-en">{command.description['en-US'] ?? Object.values(command.description)[0]}</span><span class="locale-zh">{command.description['zh-CN'] ?? Object.values(command.description)[0]}</span></dd></div>
                  {command.skill && <div><dt>Skill / 技能</dt><dd><code>{command.skill}</code></dd></div>}
                  {command.docsSlug && <div><dt>Docs / 文档</dt><dd><code>{command.docsSlug}</code></dd></div>}
                </dl>
                <h4><span class="locale-en">Invocation template</span><span class="locale-zh">调用模板</span></h4>
                <pre><code>{command.preludeTemplate}</code></pre>
              </article>
            ))}
          </div>
        )
      }
    </section>

    {
      presentation.prompts && (
        <section class="panel prompt-context" aria-labelledby="prompt-heading">
          <h2 id="prompt-heading"><span class="locale-en">Prompt context</span><span class="locale-zh">提示词上下文</span></h2>
          <ul class="kv">
            <li><span class="kv__k">Locales / 语言</span><span class="kv__v">{presentation.prompts.supportedLocales.join(', ')}</span></li>
            <li><span class="kv__k">Default / 默认</span><span class="kv__v">{presentation.prompts.defaultLocale}</span></li>
            <li><span class="kv__k">Templates / 模板</span><span class="kv__v kv__v--mono">{presentation.prompts.templates.join(', ') || '—'}</span></li>
          </ul>
          <h3><span class="locale-en">Inputs</span><span class="locale-zh">输入</span></h3>
          <ul class="reqs">
            {presentation.prompts.inputs.map((input) => (
              <li><code>{input.name}</code>{input.required ? ' · required' : ''}{input.description ? ` · ${input.description}` : ''}</li>
            ))}
          </ul>
        </section>
      )
    }

    <dl class="facts">
      <div><dt><span class="locale-en">Version</span><span class="locale-zh">版本</span></dt><dd>v{detail.version}</dd></div>
      <div><dt><span class="locale-en">Category</span><span class="locale-zh">分类</span></dt><dd>{detail.category}</dd></div>
      <div><dt><span class="locale-en">Publisher</span><span class="locale-zh">发布者</span></dt><dd>{detail.publisher}</dd></div>
      <div>
        <dt><span class="locale-en">Source</span><span class="locale-zh">来源</span></dt>
        <dd><a href={detail.source} target="_blank" rel="noopener noreferrer">{detail.source}</a></dd>
      </div>
    </dl>

    <section class="panel">
      <h2><span class="locale-en">Compatibility</span><span class="locale-zh">兼容性</span></h2>
      <ul class="kv">
        <li><span class="kv__k">Agent</span><span class="kv__v">{compat.agent}</span></li>
        <li>
          <span class="kv__k">Skills</span>
          <span class="kv__v">{compat.skills.length > 0 ? compat.skills.join(', ') : '—'}</span>
        </li>
        <li>
          <span class="kv__k">CLI</span>
          <span class="kv__v">{compat.cli.length > 0 ? compat.cli.map((c) => c.name).join(', ') : '—'}</span>
        </li>
      </ul>
    </section>

    <section class="panel">
      <h2><span class="locale-en">Requirements</span><span class="locale-zh">运行要求</span></h2>
      {
        hasRequirements ? (
          <ul class="reqs">
            {detail.requirements.map((r) => (
              <li>
                <code>{r.type}</code> <strong>{r.name}</strong>
                {r.command && <span class="reqs__note"> · {r.command}</span>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="muted">
            <span class="locale-en">No explicit requirements declared.</span>
            <span class="locale-zh">未声明显式要求。</span>
          </p>
        )
      }
    </section>

    <section class="panel">
      <h2><span class="locale-en">Installation</span><span class="locale-zh">安装</span></h2>
      <ul class="kv">
        <li><span class="kv__k">Package</span><span class="kv__v"><a href={detail.installation.packageUrl}>{detail.installation.packageUrl}</a></span></li>
        <li><span class="kv__k">Media type</span><span class="kv__v">{detail.installation.mediaType}</span></li>
        <li><span class="kv__k">Size</span><span class="kv__v">{detail.installation.size} bytes</span></li>
        <li>
          <span class="kv__k">SHA-256</span>
          <span class="kv__v kv__v--mono">{detail.installation.sha256}</span>
        </li>
      </ul>
    </section>

    {
      externalDocs.length > 0 && (
        <section class="panel">
          <h2><span class="locale-en">Documentation</span><span class="locale-zh">文档</span></h2>
          <ul class="docs">
            {externalDocs.map((doc) => (
              <li>
                <a href={doc.url}>{doc.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="panel">
      <h2><span class="locale-en">Resources</span><span class="locale-zh">资源</span></h2>
      <ul class="kv">
        <li><span class="kv__k">Manifest</span><span class="kv__v">{detail.resources.manifest}</span></li>
        <li><span class="kv__k">Backend</span><span class="kv__v">{detail.resources.backend}</span></li>
        <li><span class="kv__k">Frontend</span><span class="kv__v">{detail.resources.frontend}</span></li>
        <li><span class="kv__k">Prompts</span><span class="kv__v">{detail.resources.prompts}</span></li>
        <li><span class="kv__k">Locales</span><span class="kv__v">{detail.resources.locales.join(', ')}</span></li>
        <li><span class="kv__k">Store page</span><span class="kv__v">{detail.resources.storePage.join(', ')}</span></li>
      </ul>
    </section>

    <section class="panel">
      <h2><span class="locale-en">Community</span><span class="locale-zh">社区</span></h2>
      <ul class="kv">
        <li>
          <span class="kv__k"><span class="locale-en">Package source</span><span class="locale-zh">包源码</span></span>
          <span class="kv__v">          <a href={packageSourceUrl} target="_blank" rel="noopener noreferrer">{detail.taskId}/</a></span>
        </li>
        <li>
          <span class="kv__k"><span class="locale-en">Contribute</span><span class="locale-zh">贡献</span></span>
          <span class="kv__v">
            <a href={contributionGuideUrl} target="_blank" rel="noopener noreferrer">
              <span class="locale-en">Contribution guide</span><span class="locale-zh">贡献指南</span>
            </a>
          </span>
        </li>
        <li>
          <span class="kv__k"><span class="locale-en">Schemas</span><span class="locale-zh">Schema</span></span>
          <span class="kv__v">
            <a href={schemaReferenceUrl} target="_blank" rel="noopener noreferrer">
              <span class="locale-en">Schema reference</span><span class="locale-zh">Schema 参考</span>
            </a>
          </span>
        </li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .page {
    max-width: 820px;
    margin: 0 auto;
    padding: var(--content-gap) 1.5rem 4rem;
  }

  .breadcrumb a {
    color: var(--color-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  .detail__head {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: flex-start;
    justify-content: space-between;
    margin: 1rem 0 2rem;
  }

  .detail__title {
    margin: 0 0 0.5rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .detail__summary {
    margin: 0;
    color: var(--color-muted);
    max-width: 48rem;
  }

  .detail__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: none;
  }

  .btn {
    display: inline-flex;
    padding: 0.75rem 1.5rem;
    border-radius: 0.75rem;
    font-weight: 600;
    text-decoration: none;
  }

  .btn--primary {
    background: linear-gradient(120deg, var(--color-accent-surface), var(--color-accent-2));
    color: var(--color-on-accent);
  }


  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
    margin: 0 0 2rem;
  }

  .facts div {
    padding: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.02);
  }

  .facts dt {
    color: var(--color-accent);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.35rem;
  }

  .facts dd {
    margin: 0;
    font-weight: 600;
  }

  .facts dd a {
    color: var(--color-accent);
    word-break: break-all;
  }

  .panel {
    margin: 0 0 1.5rem;
    padding: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.02);
  }

  .panel h2 {
    margin-top: 0;
    font-size: 1.1rem;
    color: var(--color-accent);
  }

  .store-page__content :global(h2),
  .store-page__content :global(h3) { color: var(--color-fg); }
  .store-page__content :global(a) { color: var(--color-accent); }
  .locale-content { display: none; }
  html[data-locale='en-US'] .locale-content--en-US,
  html[data-locale='zh-CN'] .locale-content--zh-CN,
  html[data-locale='en-US'] .locale-content--fallback-en,
  html[data-locale='zh-CN'] .locale-content--fallback-zh { display: block; }
  .command-catalog { margin-top: 2rem; }
  .command-catalog__intro h2 { color: var(--color-accent); }
  .command-nav { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.5rem; }
  .command-nav__link { display: grid; gap: .1rem; padding: .65rem .8rem; border: 1px solid var(--color-border); color: var(--color-fg); text-decoration: none; }
  .command-nav__link:hover, .command-nav__link:focus-visible { border-color: var(--color-accent); }
  .command-nav__link span { color: var(--color-muted); font-size: .78rem; }
  .command { scroll-margin-top: calc(var(--header-height) + 1rem); }
  .command:target { border-color: var(--color-accent); box-shadow: 0 0 0 2px var(--color-accent-soft); }
  .command h3 { margin-top: 0; }
  .command h4, .prompt-context h3 { color: var(--color-accent); }
  pre { overflow-x: auto; padding: 1rem; border: 1px solid var(--color-border); background: var(--color-bg); }
  pre code { white-space: pre-wrap; overflow-wrap: anywhere; }

  .kv {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .kv li {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 1rem;
  }

  .kv__k {
    color: var(--color-muted);
  }

  .kv__v--mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8rem;
    word-break: break-all;
  }

  .kv__v a {
    color: var(--color-accent);
  }

  .reqs {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.4rem;
  }

  .reqs code {
    background: rgba(109, 139, 255, 0.14);
    color: var(--color-accent);
    padding: 0.1rem 0.4rem;
    border-radius: 0.35rem;
    font-size: 0.8rem;
  }

  .reqs__note {
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .docs {
    margin: 0;
    padding-left: 1.1rem;
  }

  .docs a {
    color: var(--color-accent);
  }

  .muted {
    color: var(--color-muted);
  }

  @media (max-width: 620px) {
    .kv li { grid-template-columns: 1fr; gap: .15rem; }
    .command-nav { display: grid; grid-template-columns: 1fr 1fr; }
  }
</style>