---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCatalog, type DetailDoc } from '@/lib/community-index';

export const getStaticPaths: GetStaticPaths = () => {
  const { details } = getCatalog();
  return details.map((detail) => ({
    params: { taskId: detail.taskId },
    props: { detail },
  }));
};

interface Props {
  detail: DetailDoc;
}

const { detail } = Astro.props as Props;
const nameEn = detail.name['en-US'] ?? Object.values(detail.name)[0] ?? detail.taskId;
const nameZh = detail.name['zh-CN'] ?? nameEn;
const summaryEn = detail.summary['en-US'] ?? '';
const summaryZh = detail.summary['zh-CN'] ?? summaryEn;
const compat = detail.compatibility;
const externalDocs = detail.documentation?.external ?? [];
const hasRequirements = detail.requirements.length > 0;
const packageSourceUrl = `${detail.source}/tree/main/data/${detail.taskId}`;
const contributionGuideUrl = `${detail.source}#contribute-a-task`;
const schemaReferenceUrl = 'https://github.com/HagiCode-org/hagitask/tree/main/schemas';
---

<BaseLayout title={`${nameEn} · HagiTask`}>
  <main class="page">
    <nav class="breadcrumb">
      <a href="/">&larr; <span class="locale-en">All tasks</span><span class="locale-zh">全部任务</span></a>
    </nav>

    <header class="detail__head">
      <div>
        <h1 class="detail__title">
          <span class="locale-en">{nameEn}</span><span class="locale-zh">{nameZh}</span>
        </h1>
        <p class="detail__summary">
          <span class="locale-en block">{summaryEn}</span><span class="locale-zh block">{summaryZh}</span>
        </p>
      </div>
      <div class="detail__actions">
        <a class="btn btn--primary" href={detail.installation.packageUrl}>
          <span class="locale-en">Download package</span><span class="locale-zh">下载包</span>
        </a>
        <div class="locale-toggle" role="group" aria-label="Language">
          <button type="button" data-locale-toggle="en-US" class="locale-toggle__btn">EN</button>
          <button type="button" data-locale-toggle="zh-CN" class="locale-toggle__btn">中文</button>
        </div>
      </div>
    </header>

    <dl class="facts">
      <div><dt><span class="locale-en">Version</span><span class="locale-zh">版本</span></dt><dd>v{detail.version}</dd></div>
      <div><dt><span class="locale-en">Category</span><span class="locale-zh">分类</span></dt><dd>{detail.category}</dd></div>
      <div><dt><span class="locale-en">Publisher</span><span class="locale-zh">发布者</span></dt><dd>{detail.publisher}</dd></div>
      <div>
        <dt><span class="locale-en">Source</span><span class="locale-zh">来源</span></dt>
        <dd><a href={detail.source} target="_blank" rel="noreferrer">{detail.source}</a></dd>
      </div>
    </dl>

    <section class="panel">
      <h2><span class="locale-en">Compatibility</span><span class="locale-zh">兼容性</span></h2>
      <ul class="kv">
        <li><span class="kv__k">Agent</span><span class="kv__v">{compat.agent}</span></li>
        <li>
          <span class="kv__k">Skills</span>
          <span class="kv__v">{compat.skills.length > 0 ? compat.skills.join(', ') : '—'}</span>
        </li>
        <li>
          <span class="kv__k">CLI</span>
          <span class="kv__v">{compat.cli.length > 0 ? compat.cli.map((c) => c.name).join(', ') : '—'}</span>
        </li>
      </ul>
    </section>

    <section class="panel">
      <h2><span class="locale-en">Requirements</span><span class="locale-zh">运行要求</span></h2>
      {
        hasRequirements ? (
          <ul class="reqs">
            {detail.requirements.map((r) => (
              <li>
                <code>{r.type}</code> <strong>{r.name}</strong>
                {r.command && <span class="reqs__note"> · {r.command}</span>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="muted">
            <span class="locale-en">No explicit requirements declared.</span>
            <span class="locale-zh">未声明显式要求。</span>
          </p>
        )
      }
    </section>

    <section class="panel">
      <h2><span class="locale-en">Installation</span><span class="locale-zh">安装</span></h2>
      <ul class="kv">
        <li><span class="kv__k">Package</span><span class="kv__v"><a href={detail.installation.packageUrl}>{detail.installation.packageUrl}</a></span></li>
        <li><span class="kv__k">Media type</span><span class="kv__v">{detail.installation.mediaType}</span></li>
        <li><span class="kv__k">Size</span><span class="kv__v">{detail.installation.size} bytes</span></li>
        <li>
          <span class="kv__k">SHA-256</span>
          <span class="kv__v kv__v--mono">{detail.installation.sha256}</span>
        </li>
      </ul>
    </section>

    {
      externalDocs.length > 0 && (
        <section class="panel">
          <h2><span class="locale-en">Documentation</span><span class="locale-zh">文档</span></h2>
          <ul class="docs">
            {externalDocs.map((doc) => (
              <li>
                <a href={doc.url}>{doc.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="panel">
      <h2><span class="locale-en">Resources</span><span class="locale-zh">资源</span></h2>
      <ul class="kv">
        <li><span class="kv__k">Manifest</span><span class="kv__v">{detail.resources.manifest}</span></li>
        <li><span class="kv__k">Backend</span><span class="kv__v">{detail.resources.backend}</span></li>
        <li><span class="kv__k">Frontend</span><span class="kv__v">{detail.resources.frontend}</span></li>
        <li><span class="kv__k">Prompts</span><span class="kv__v">{detail.resources.prompts}</span></li>
        <li><span class="kv__k">Locales</span><span class="kv__v">{detail.resources.locales.join(', ')}</span></li>
        <li><span class="kv__k">Store page</span><span class="kv__v">{detail.resources.storePage.join(', ')}</span></li>
      </ul>
    </section>

    <section class="panel">
      <h2><span class="locale-en">Community</span><span class="locale-zh">社区</span></h2>
      <ul class="kv">
        <li>
          <span class="kv__k"><span class="locale-en">Package source</span><span class="locale-zh">包源码</span></span>
          <span class="kv__v"><a href={packageSourceUrl} target="_blank" rel="noreferrer">{detail.taskId}/</a></span>
        </li>
        <li>
          <span class="kv__k"><span class="locale-en">Contribute</span><span class="locale-zh">贡献</span></span>
          <span class="kv__v">
            <a href={contributionGuideUrl} target="_blank" rel="noreferrer">
              <span class="locale-en">Contribution guide</span><span class="locale-zh">贡献指南</span>
            </a>
          </span>
        </li>
        <li>
          <span class="kv__k"><span class="locale-en">Schemas</span><span class="locale-zh">Schema</span></span>
          <span class="kv__v">
            <a href={schemaReferenceUrl} target="_blank" rel="noreferrer">
              <span class="locale-en">Schema reference</span><span class="locale-zh">Schema 参考</span>
            </a>
          </span>
        </li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .page {
    max-width: 820px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .breadcrumb a {
    color: var(--color-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  .detail__head {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: flex-start;
    justify-content: space-between;
    margin: 1rem 0 2rem;
  }

  .detail__title {
    margin: 0 0 0.5rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .detail__summary {
    margin: 0;
    color: var(--color-muted);
    max-width: 48rem;
  }

  .detail__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: none;
  }

  .btn {
    display: inline-flex;
    padding: 0.75rem 1.5rem;
    border-radius: 0.75rem;
    font-weight: 600;
    text-decoration: none;
  }

  .btn--primary {
    background: linear-gradient(120deg, var(--color-accent), var(--color-accent-2));
    color: #fff;
  }

  .locale-toggle {
    display: inline-flex;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .locale-toggle__btn {
    background: transparent;
    color: var(--color-muted);
    border: none;
    padding: 0.7rem 0.9rem;
    cursor: pointer;
    font-weight: 600;
  }

  .locale-toggle__btn:hover {
    color: var(--color-fg);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
    margin: 0 0 2rem;
  }

  .facts div {
    padding: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.02);
  }

  .facts dt {
    color: var(--color-accent);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.35rem;
  }

  .facts dd {
    margin: 0;
    font-weight: 600;
  }

  .facts dd a {
    color: var(--color-accent);
    word-break: break-all;
  }

  .panel {
    margin: 0 0 1.5rem;
    padding: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.02);
  }

  .panel h2 {
    margin-top: 0;
    font-size: 1.1rem;
    color: var(--color-accent);
  }

  .kv {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .kv li {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 1rem;
  }

  .kv__k {
    color: var(--color-muted);
  }

  .kv__v--mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8rem;
    word-break: break-all;
  }

  .kv__v a {
    color: var(--color-accent);
  }

  .reqs {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.4rem;
  }

  .reqs code {
    background: rgba(109, 139, 255, 0.14);
    color: var(--color-accent);
    padding: 0.1rem 0.4rem;
    border-radius: 0.35rem;
    font-size: 0.8rem;
  }

  .reqs__note {
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .docs {
    margin: 0;
    padding-left: 1.1rem;
  }

  .docs a {
    color: var(--color-accent);
  }

  .muted {
    color: var(--color-muted);
  }
</style>