---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TaskCard from '@/components/TaskCard.astro';
import PromoteCard from '@/components/PromoteCard.astro';
import { getCatalog, SOURCE_ROOT } from '@/lib/community-index';

const { index } = getCatalog();
const tasks = index.tasks;
const categories = Array.from(new Set(tasks.map((t) => t.category))).sort();
const contributionGuideUrl = `${SOURCE_ROOT}#contribute-a-task`;
const schemaReferenceUrl = 'https://github.com/HagiCode-org/hagitask/tree/main/schemas';
---

<BaseLayout title="HagiTask · Community Tasks">
  <main class="page">
    <PromoteCard />
    <section class="hero" aria-labelledby="page-title">
      <p class="hero__eyebrow">HagiCode · Community Tasks</p>
      <h1 class="hero__title" id="page-title">
        <span class="locale-en">HagiTask Community</span>
        <span class="locale-zh">HagiTask 社区任务</span>
      </h1>
      <p class="hero__subtitle">
        <span class="locale-en">Discover reusable workflows for HagiCode.</span>
        <span class="locale-zh">发现可复用的 HagiCode 工作流。</span>
      </p>
      <div class="hero__actions" aria-label="Resource links">
        <a class="hero__btn hero__btn--primary" href="/index.json">index.json</a>
        <a class="hero__btn hero__btn--ghost" href={contributionGuideUrl} target="_blank" rel="noopener noreferrer">
          <span class="locale-en">Contribute a task</span><span class="locale-zh">贡献 Task</span>
        </a>
        <a class="hero__btn hero__btn--ghost" href={schemaReferenceUrl} target="_blank" rel="noopener noreferrer">
          <span class="locale-en">Schema reference</span><span class="locale-zh">Schema 参考</span>
        </a>
        <a class="hero__btn hero__btn--ghost" href="https://github.com/HagiCode-org/hagitask-site" target="_blank" rel="noopener noreferrer">
          <span class="locale-en">Site source</span><span class="locale-zh">站点源码</span>
        </a>
      </div>
    </section>

    <section class="toolbar" aria-labelledby="catalog-heading">
      <div class="toolbar__heading">
        <p class="section-label" id="catalog-heading"><span class="locale-en">Task catalog</span><span class="locale-zh">任务目录</span></p>
        <span class="toolbar__count" id="task-count">{tasks.length} tasks</span>
      </div>
      <label class="toolbar__search-wrap">
        <span class="sr-only">Search tasks / 搜索任务</span>
        <input
          type="search"
          id="task-search"
          class="toolbar__search"
          placeholder="Search tasks..."
          aria-label="Search tasks / 搜索任务"
        />
      </label>
      <div class="toolbar__filters" id="category-filters" aria-label="Filter by category">
        <button type="button" class="chip chip--active" data-category="all">
          <span class="locale-en">All</span><span class="locale-zh">全部</span>
        </button>
        {
          categories.map((cat) => (
            <button type="button" class="chip" data-category={cat}>
              {cat}
            </button>
          ))
        }
      </div>
    </section>

    <section class="grid" id="task-grid">
      {tasks.map((task) => <TaskCard task={task} />)}
      <p class="grid__empty" id="grid-empty" hidden>
        <span class="locale-en">No tasks match your filters.</span>
        <span class="locale-zh">没有符合筛选条件的任务。</span>
      </p>
    </section>
  </main>
</BaseLayout>

<script>
  const search = document.getElementById('task-search') as HTMLInputElement | null;
  const filters = document.getElementById('category-filters');
  const grid = document.getElementById('task-grid');
  const empty = document.getElementById('grid-empty');
  const count = document.getElementById('task-count');

  function apply() {
    if (!search || !grid) return;
    const q = search.value.trim().toLowerCase();
    const active = filters?.querySelector('.chip--active') as HTMLElement | null;
    const category = active?.dataset.category ?? 'all';
    let visible = 0;
    grid.querySelectorAll<HTMLElement>('.task-card').forEach((card) => {
      const tags = (card.dataset.tags ?? '').toLowerCase();
      const name = card.textContent?.toLowerCase() ?? '';
      const matchQ = q === '' || name.includes(q) || tags.includes(q);
      const matchCat = category === 'all' || card.dataset.category === category;
      const show = matchQ && matchCat;
      card.hidden = !show;
      if (show) visible++;
    });
    if (empty) empty.hidden = visible !== 0;
    if (count) count.textContent = `${visible} ${visible === 1 ? 'task' : 'tasks'}`;
  }

  search?.addEventListener('input', apply);
  filters?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.chip') as HTMLElement | null;
    if (!btn) return;
    filters.querySelectorAll('.chip').forEach((c) => c.classList.remove('chip--active'));
    btn.classList.add('chip--active');
    apply();
  });
</script>

<style>
  .page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3.5rem 1.25rem 5rem;
  }

  .hero {
    text-align: center;
    padding: 4rem 1rem 5rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background:
      radial-gradient(60% 60% at 50% 0%, rgba(250, 255, 105, 0.14), transparent 70%);
  }

  .hero__eyebrow {
    margin: 0 0 1rem;
    color: var(--color-accent);
    font-size: 0.875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero__title {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 900;
    letter-spacing: -0.06em;
  }

  .hero__subtitle {
    margin: 1rem auto 1.75rem;
    max-width: 38rem;
    color: var(--color-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    max-width: 100%;
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.25rem;
    border-radius: 4px;
    font-weight: 600;
    text-decoration: none;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .hero__btn--primary {
    background: var(--color-accent-surface);
    color: var(--color-on-accent);
  }

  .hero__btn--ghost {
    border: 1px solid var(--color-border);
    color: var(--color-fg);
  }


  .toolbar {
    display: grid;
    grid-template-columns: minmax(12rem, .6fr) minmax(24rem, 2fr);
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin: 3rem 0 1.5rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .toolbar__heading { display: flex; align-items: center; gap: .75rem; grid-column: 1 / -1; }
  .section-label { margin: 0; color: var(--color-accent); font-size: .8rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .toolbar__count { color: var(--color-muted); font-size: .8rem; }
  .toolbar__search-wrap { display: block; }
  .toolbar__search {
    flex: 1 1 220px;
    padding: 0.7rem 1rem;
    border-radius: 4px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-fg);
    font-size: 0.95rem;
  }

  .toolbar__search:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .toolbar__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    padding: 0.45rem 0.9rem;
    border-radius: 4px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    font-size: 0.85rem;
  }

  .chip--active {
    background: var(--color-accent-surface);
    color: #151515;
    border-color: var(--color-accent-surface);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .grid__empty {
    grid-column: 1 / -1;
    text-align: center;
    color: var(--color-muted);
    padding: 2rem;
  }

  @media (max-width: 700px) {
    .page { padding-inline: .75rem; }
    .hero { padding: 3rem 1rem; }
    .hero__actions { width: 100%; }
    .hero__btn { flex: 1 1 auto; min-width: 0; }
    .hero__actions img { max-width: 100%; height: auto; }
    .toolbar { grid-template-columns: 1fr; }
    .toolbar__filters { grid-column: 1; }
  }

  @media (max-width: 1180px) {
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 620px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>