---
/**
 * Google Analytics 4 集成组件。
 * 仅在生产构建中输出脚本，SDK 使用 async 加载，不阻塞页面主体。
 */
const DEFAULT_GA_MEASUREMENT_ID = 'G-EN03FMT2Q4';
const measurementId =
  import.meta.env.VITE_GA_MEASUREMENT_ID || DEFAULT_GA_MEASUREMENT_ID;
const shouldRender = import.meta.env.PROD;
---

{
  shouldRender && (
    <>
      <script
        async
        is:inline
        src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}
      />
      <script
        is:inline
        set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${measurementId}');`}
      />
    </>
  )
}
