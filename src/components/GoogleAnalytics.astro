---
/**
 * Google Analytics 4 集成组件。委托给 Hagilight 共享组件:仅在生产构建输出脚本,
 * 暴露 window.gtag,并安装 data-ga-* 点击事件监听器。
 */
import CoreGoogleAnalytics from '@hagicode/hagilight-core/GoogleAnalytics';

const DEFAULT_GA_MEASUREMENT_ID = 'G-EN03FMT2Q4';
const measurementId =
  import.meta.env.VITE_GA_MEASUREMENT_ID || DEFAULT_GA_MEASUREMENT_ID;
---

<CoreGoogleAnalytics measurementId={measurementId} />
