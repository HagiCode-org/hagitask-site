<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label="HagiTask home">
      <span class="site-header__mark">H</span>
      <span>HagiTask</span>
    </a>
    <nav class="site-header__nav" aria-label="Primary navigation">
      <a href="/"><span class="locale-en">Catalog</span><span class="locale-zh">目录</span></a>
      <a href="/schemas/"><span class="locale-en">Schemas</span><span class="locale-zh">Schema</span></a>
      <a href="https://github.com/HagiCode-org/hagitask" target="_blank" rel="noopener noreferrer"><span class="locale-en">Community</span><span class="locale-zh">社区</span></a>
    </nav>
    <div class="site-header__controls">
      <div class="locale-toggle" role="group" aria-label="Language">
        <button type="button" data-locale-toggle="en-US">EN</button>
        <button type="button" data-locale-toggle="zh-CN">中文</button>
      </div>
      <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false">
        <span aria-hidden="true">◐</span><span class="theme-toggle__label locale-en">Theme</span><span class="theme-toggle__label locale-zh">主题</span>
      </button>
      <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-navigation">
        <span class="sr-only">Toggle navigation</span><span aria-hidden="true">☰</span>
      </button>
    </div>
  </div>
  <div class="mobile-navigation" id="mobile-navigation" data-mobile-navigation hidden>
    <div class="mobile-navigation__backdrop" data-menu-close></div>
    <nav class="mobile-navigation__panel" aria-label="Mobile navigation">
      <a href="/"><span class="locale-en">Catalog</span><span class="locale-zh">目录</span></a>
      <a href="/schemas/"><span class="locale-en">Schemas</span><span class="locale-zh">Schema</span></a>
      <a href="https://github.com/HagiCode-org/hagitask" target="_blank" rel="noopener noreferrer"><span class="locale-en">Community</span><span class="locale-zh">社区</span></a>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 10; border-bottom: 1px solid var(--color-border); background: color-mix(in srgb, var(--color-bg) 92%, transparent); backdrop-filter: blur(12px); }
  .site-header__inner { max-width: var(--max-width); min-height: var(--header-height); margin: 0 auto; padding: 0 1.5rem; display: flex; align-items: center; gap: 2rem; }
  .site-header__brand { display: inline-flex; align-items: center; gap: .6rem; color: var(--color-fg); font-weight: 800; text-decoration: none; }
  .site-header__mark { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: .6rem; background: linear-gradient(135deg, var(--color-accent), var(--color-accent-2)); color: #fff; }
  .site-header__nav { display: flex; gap: 1.25rem; flex: 1; }
  .site-header a { color: var(--color-muted); text-decoration: none; }
  .site-header a:hover { color: var(--color-fg); }
  .site-header__controls { display: flex; align-items: center; gap: .65rem; }
  .locale-toggle { display: inline-flex; overflow: hidden; border: 1px solid var(--color-border); border-radius: .55rem; }
  .locale-toggle button, .theme-toggle, .menu-toggle { min-height: 2.25rem; border: 0; background: transparent; color: var(--color-muted); cursor: pointer; font: inherit; }
  .locale-toggle button { padding: .35rem .6rem; }
  .locale-toggle button[aria-pressed='true'] { background: var(--color-accent-soft); color: var(--color-accent); }
  .theme-toggle { display: inline-flex; align-items: center; gap: .35rem; padding: .35rem .55rem; border: 1px solid var(--color-border); border-radius: .55rem; }
  .menu-toggle { display: none; padding: .35rem .55rem; border: 1px solid var(--color-border); border-radius: .55rem; }
  .mobile-navigation { position: fixed; inset: var(--header-height) 0 0; }
  .mobile-navigation__backdrop { position: absolute; inset: 0; background: rgba(0, 0, 0, .45); }
  .mobile-navigation__panel { position: absolute; right: 1rem; top: 1rem; display: grid; gap: .25rem; min-width: 14rem; padding: .75rem; border: 1px solid var(--color-border); border-radius: .8rem; background: var(--color-surface); box-shadow: var(--shadow); }
  .mobile-navigation__panel a { padding: .7rem; }
  @media (max-width: 700px) { .site-header__nav, .site-header__controls .theme-toggle__label { display: none; } .menu-toggle { display: inline-block; } .site-header__inner { justify-content: space-between; } }
</style>
