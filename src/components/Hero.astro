---
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'HagiTask',
  subtitle = 'HagiCode 生态下的任务与流程管理站点',
} = Astro.props;
---

<section class="hero">
  <div class="hero__inner">
    <p class="hero__eyebrow">HagiCode · Task</p>
    <h1 class="hero__title">{title}</h1>
    <p class="hero__subtitle">{subtitle}</p>
    <div class="hero__actions">
      <a class="hero__btn hero__btn--primary" href="https://github.com/HagiCode-org/hagitask">
        查看后端仓库
      </a>
      <a class="hero__btn hero__btn--ghost" href="https://github.com/HagiCode-org/hagitask-site">
        站点源码
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 70vh;
    padding: 4rem 1.5rem;
    background:
      radial-gradient(60% 60% at 50% 0%, rgba(109, 139, 255, 0.18), transparent 70%),
      radial-gradient(50% 50% at 80% 30%, rgba(139, 92, 246, 0.14), transparent 70%);
  }

  .hero__inner {
    max-width: var(--max-width);
    text-align: center;
  }

  .hero__eyebrow {
    margin: 0 0 1rem;
    color: var(--color-accent);
    font-size: 0.875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero__title {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    background: linear-gradient(120deg, var(--color-fg), var(--color-accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__subtitle {
    margin: 1.25rem auto 2rem;
    max-width: 38rem;
    color: var(--color-muted);
    font-size: 1.125rem;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border-radius: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .hero__btn:hover {
    transform: translateY(-2px);
  }

  .hero__btn--primary {
    background: linear-gradient(120deg, var(--color-accent), var(--color-accent-2));
    color: #fff;
  }

  .hero__btn--ghost {
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: var(--color-fg);
  }
</style>
