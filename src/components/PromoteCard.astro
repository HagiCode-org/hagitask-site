<aside class="promote-card" data-promote-card hidden aria-label="Promotion">
  <button class="promote-card__close" type="button" data-promote-close aria-label="Dismiss promotion">×</button>
  <div class="promote-card__body">
    <div>
      <p class="promote-card__eyebrow">HagiCode</p>
      <h2 data-promote-title></h2>
      <p class="promote-card__description" data-promote-description></p>
    </div>
    <img class="promote-card__image" data-promote-image alt="" hidden />
    <a class="promote-card__cta" data-promote-link target="_blank" rel="noopener noreferrer"></a>
  </div>
</aside>

<script>
  import { loadFirstActivePromotion } from '@/lib/promote-loader';

  const card = document.querySelector<HTMLElement>('[data-promote-card]');
  const locale = () => document.documentElement.dataset.locale ?? 'en-US';
  const dismissedKey = 'hagitask-promotion-dismissed';

  async function loadPromotion() {
    if (!card) return;
    try {
      if (localStorage.getItem(dismissedKey)) return;
    } catch {}
    const promotion = await loadFirstActivePromotion(locale());
    if (!promotion) return;
    card.querySelector('[data-promote-title]')!.textContent = promotion.title;
    card.querySelector('[data-promote-description]')!.textContent = promotion.description;
    const link = card.querySelector<HTMLAnchorElement>('[data-promote-link]')!;
    link.href = promotion.link;
    link.textContent = `${promotion.ctaLabel} →`;
    if (promotion.image) {
      const image = card.querySelector<HTMLImageElement>('[data-promote-image]')!;
      image.src = promotion.image.src;
      image.alt = promotion.image.alt ?? promotion.title;
      image.hidden = false;
    }
    card.dataset.promotionId = promotion.id;
    card.hidden = false;
  }

  card?.querySelector('[data-promote-close]')?.addEventListener('click', () => {
    card.hidden = true;
    try { localStorage.setItem(dismissedKey, card.dataset.promotionId ?? 'dismissed'); } catch {}
  });
  void loadPromotion();
</script>

<style>
  .promote-card { position: relative; margin: 0 0 1.5rem; padding: 1rem 3.5rem 1rem 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius); background: linear-gradient(120deg, var(--color-accent-soft), var(--color-surface)); }
  .promote-card__body { display: grid; grid-template-columns: 1fr auto auto; gap: 1rem; align-items: center; }
  .promote-card h2, .promote-card p { margin: 0; }
  .promote-card h2 { font-size: 1.1rem; }
  .promote-card__eyebrow { margin-bottom: .25rem !important; color: var(--color-accent); font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; }
  .promote-card__description { color: var(--color-muted); }
  .promote-card__image { width: 7rem; height: 4rem; border-radius: .5rem; object-fit: cover; }
  .promote-card__cta { color: var(--color-accent); font-weight: 700; text-decoration: none; white-space: nowrap; }
  .promote-card__close { position: absolute; top: .5rem; right: .6rem; border: 0; background: transparent; color: var(--color-muted); cursor: pointer; font-size: 1.4rem; }
  @media (max-width: 700px) { .promote-card__body { grid-template-columns: 1fr; gap: .5rem; } .promote-card__image { width: 100%; height: 5rem; } .promote-card__cta { white-space: normal; } }
</style>
